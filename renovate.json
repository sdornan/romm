{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "enabledManagers": ["github-actions", "docker-compose", "custom.regex"],
  "ignorePaths": ["examples/**"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Keep each service's pins moving together so CI, dev and the test stack cannot drift apart",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mariadb"],
      "groupName": "mariadb"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "groupName": "postgres"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["valkey/valkey"],
      "groupName": "valkey"
    },
    {
      "description": "A major database upgrade rewrites the on-disk format and has no in-place downgrade",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mariadb", "postgres"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["needs-migration-review"]
    },
    {
      "description": "One PR for the pinned action SHAs rather than one apiece",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Matrix legs in migrations.yml build their tag at runtime, so Renovate cannot see them as image references",
      "managerFilePatterns": ["/^\\.github/workflows/migrations\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)\\s+- version: \"(?<currentValue>[^\"]+?)\""
      ]
    }
  ]
}
